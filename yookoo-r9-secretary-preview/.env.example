# No credentials included. Configure secrets only in the existing Worker's settings.
SECRETARY_MODE=preview
SECRETARY_REMINDERS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Alternative: existing short-lived token, do not set both paths unnecessarily.
GOOGLE_ACCESS_TOKEN=
GOOGLE_WRITE_ENABLED=false

# Off by default: Calendar already has personal popups. Enable only if Telegram copies are wanted.
PERSONAL_REMINDERS=false
